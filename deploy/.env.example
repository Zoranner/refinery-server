# Refinery HTTP 监听地址
HTTP_LISTEN_ADDRESS=0.0.0.0

# Refinery HTTP 监听端口（容器内部端口）
HTTP_LISTEN_PORT=8080

# Docker 网络中的 SearXNG 地址
SEARXNG_BASE_URL=http://searxng:8888

# Docker 网络中的 Jina Reader 地址
READER_BASE_URL=http://reader:8081

# 单次原始资源下载请求的最长等待时间（秒）
RESOURCE_REQUEST_TIMEOUT_SECONDS=20

# 单次 Reader 抽取请求的最长等待时间（秒）
READER_REQUEST_TIMEOUT_SECONDS=60

# MCP 请求允许的 Host authority，逗号分隔；内网部署必须填写实际 authority，例如 192.168.2.16:18090
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
